                                    <!-- Multiline Notes TextBox -->
                                    <TextBox x:Name="notesTextboxMulti" Grid.Row="1" FontSize="20" FontWeight="Bold"
                                             AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                             Padding="8" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1"
                                             TextChanged="notesTextboxMulti_TextChanged"
                                             TextBlock.FontSize="24" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" />

                                    <!-- Live Status Bar: Sum & Average -->
                                    <Border Grid.Row="2" Background="#F1F5F9" CornerRadius="6" Padding="10,6" Margin="0,8,0,0" BorderBrush="#CBD5E1" BorderThickness="1">
                                        <Grid>
                                            <TextBlock Text="Live Calculation / لائیو حساب:" VerticalAlignment="Center" FontSize="16" FontWeight="Bold" Foreground="#475569" HorizontalAlignment="Left" />
                                            <TextBlock x:Name="notesAvgSumTextMulti" Text="Lines: 0 | Sum: 0.00 | Avg: 0.00" HorizontalAlignment="Right" FontSize="18" FontWeight="Bold" Foreground="#0284C7" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Batch Items Grid & Grand Totals Section (Row 2, Spans Col 0 & Col 1) -->
                        <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="12,12,12,12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Table Header Title -->
                            <TextBlock Grid.Row="0" Text="Tested Products in Batch / بیچ میں شامل آئٹمز:" FontSize="22" FontWeight="Bold" Foreground="#1E3A8A" Margin="0,0,0,8" />

                            <!-- Batch DataGrid -->
                            <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8">
                                <DataGrid x:Name="batchDataGrid"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          IsReadOnly="True"
                                          GridLinesVisibility="Horizontal"
                                          HorizontalGridLinesBrush="#E2E8F0"
                                          VerticalGridLinesBrush="Transparent"
                                          RowHeight="38"
                                          FontSize="16"
                                          FontWeight="Bold"
                                          HeadersVisibility="Column"
                                          Background="#FFFFFF"
                                          AlternatingRowBackground="#F8FAFC"
                                          BorderThickness="0"
                                          MaxHeight="260">
                                    <DataGrid.ColumnHeaderStyle>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="Background" Value="#F1F5F9" />
                                            <Setter Property="Foreground" Value="#334155" />
                                            <Setter Property="FontWeight" Value="Bold" />
                                            <Setter Property="FontSize" Value="15" />
                                            <Setter Property="Height" Value="38" />
                                            <Setter Property="Padding" Value="4,0" />
                                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                                            <Setter Property="BorderBrush" Value="#CBD5E1" />
                                        </Style>
                                    </DataGrid.ColumnHeaderStyle>
                                    <DataGrid.Columns>
                                        <!-- Col 0: Index -->
                                        <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="45">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="VerticalAlignment" Value="Center" />
                                                    <Setter Property="TextAlignment" Value="Center" />
                                                    <Setter Property="FontWeight" Value="Bold" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <!-- Col 1: Item -->
                                        <DataGridTextColumn Header="Item" Binding="{Binding ItemDisplay}" Width="120">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="VerticalAlignment" Value="Center" />
                                                    <Setter Property="Padding" Value="4,0" />
                                                    <Setter Property="FontWeight" Value="Bold" />
                                                    <Setter Property="Foreground" Value="#B45309" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <!-- Col 2: Gross Weight -->
                                        <DataGridTextColumn Header="Weight" Binding="{Binding WeightDisplay}" Width="90">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="VerticalAlignment" Value="Center" />
                                                    <Setter Property="TextAlignment" Value="Right" />
                                                    <Setter Property="Padding" Value="4,0" />
                                                    <Setter Property="FontWeight" Value="Bold" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <!-- Col 3: Taka -->
                                        <DataGridTextColumn Header="Taka" Binding="{Binding TakaDisplay}" Width="85">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="VerticalAlignment" Value="Center" />
                                                    <Setter Property="TextAlignment" Value="Right" />
                                                    <Setter Property="Padding" Value="4,0" />
                                                    <Setter Property="FontWeight" Value="Bold" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <!-- Col 4: Total Weight -->
                                        <DataGridTextColumn Header="Total Wt" Binding="{Binding TotalWeightDisplay}" Width="90">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="VerticalAlignment" Value="Center" />
                                                    <Setter Property="TextAlignment" Value="Right" />
                                                    <Setter Property="Padding" Value="4,0" />
                                                    <Setter Property="FontWeight" Value="Bold" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <!-- Col 5: Ratti -->
                                        <DataGridTextColumn Header="Ratti" Binding="{Binding RattiDisplay}" Width="65">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="VerticalAlignment" Value="Center" />
                                                    <Setter Property="TextAlignment" Value="Center" />
                                                    <Setter Property="FontWeight" Value="Bold" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <!-- Col 6: Karat -->
                                        <DataGridTextColumn Header="Karat" Binding="{Binding KaratDisplay}" Width="65">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="VerticalAlignment" Value="Center" />
                                                    <Setter Property="TextAlignment" Value="Center" />
                                                    <Setter Property="FontWeight" Value="Bold" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <!-- Col 7: Pure Gold -->
                                        <DataGridTextColumn Header="Pure Gold" Binding="{Binding PureGoldDisplay}" Width="95">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="VerticalAlignment" Value="Center" />
                                                    <Setter Property="TextAlignment" Value="Right" />
                                                    <Setter Property="Padding" Value="4,0" />
                                                    <Setter Property="FontWeight" Value="Bold" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <!-- Col 8: Labor -->
                                        <DataGridTextColumn Header="Labor" Binding="{Binding LaborDisplay}" Width="75">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="VerticalAlignment" Value="Center" />
                                                    <Setter Property="TextAlignment" Value="Right" />
                                                    <Setter Property="Padding" Value="4,0" />
                                                    <Setter Property="FontWeight" Value="Bold" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <!-- Col 9: Cash (Rs) -->
                                        <DataGridTextColumn Header="Cash (Rs)" Binding="{Binding CashDisplay}" Width="110">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="VerticalAlignment" Value="Center" />
                                                    <Setter Property="TextAlignment" Value="Right" />
                                                    <Setter Property="Padding" Value="4,0" />
                                                    <Setter Property="FontWeight" Value="Bold" />
                                                    <Setter Property="Foreground" Value="#059669" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <!-- Col 10: Action (Remove) -->
                                        <DataGridTemplateColumn Header="Action" Width="90">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="Remove" 
                                                            Height="28" 
                                                            Padding="6,0" 
                                                            FontSize="12" 
                                                            FontWeight="Bold" 
                                                            Background="#DC2626" 
                                                            Foreground="#FFFFFF" 
                                                            BorderBrush="#B91C1C" 
                                                            Click="removeBatchItem_Click" 
                                                            Tag="{Binding Index}" 
                                                            Cursor="Hand" 
                                                            VerticalAlignment="Center" 
                                                            HorizontalAlignment="Center">
                                                        <Button.Resources>
                                                            <Style TargetType="Border">
                                                                <Setter Property="CornerRadius" Value="4"/>
                                                            </Style>
                                                        </Button.Resources>
                                                    </Button>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>

                            <!-- Grand Summary Totals Cards (Row 2) -->
                            <Grid Grid.Row="2" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="1.3*" />
                                </Grid.ColumnDefinitions>

                                <!-- Total Weight Card -->
                                <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1.5" CornerRadius="8" Padding="6,6">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="Total Weight / کل وزن" FontSize="14" FontWeight="Bold" Foreground="#475569" HorizontalAlignment="Center" />
                                        <TextBlock x:Name="batchTotalWeightDisplay" Text="0.000g" FontSize="20" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>

                                <!-- Total Pure Gold Card -->
                                <Border Grid.Column="2" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1.5" CornerRadius="8" Padding="6,6">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="Total Pure / خالص سونا" FontSize="14" FontWeight="Bold" Foreground="#475569" HorizontalAlignment="Center" />
                                        <TextBlock x:Name="batchTotalPureGoldDisplay" Text="0.000g" FontSize="20" FontWeight="Bold" Foreground="#B45309" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>

                                <!-- Total Labor Card -->
                                <Border Grid.Column="4" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1.5" CornerRadius="8" Padding="6,6">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="Total Labor / کل مزدوری" FontSize="14" FontWeight="Bold" Foreground="#475569" HorizontalAlignment="Center" />
                                        <TextBlock x:Name="batchTotalLaborDisplay" Text="Rs. 0" FontSize="20" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>

                                <!-- Grand Total Cash Card -->
                                <Border Grid.Column="6" Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="2" CornerRadius="8" Padding="6,6">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="TOTAL CASH / کل رقم" FontSize="15" FontWeight="Bold" Foreground="#166534" HorizontalAlignment="Center" />
                                        <TextBlock x:Name="batchTotalCashDisplay" Text="Rs. 0" FontSize="24" FontWeight="Bold" Foreground="#059669" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- History Tab -->
            <TabItem Header="History" x:Name="historyTab" FontSize="38" FontWeight="Bold" Width="140" Background="#BAE6FD">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Top Filter Bar -->
                    <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="10,8,10,8" Margin="0,0,0,10">
                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Customer Filter -->
                            <StackPanel Orientation="Horizontal" Margin="0,4,10,4" VerticalAlignment="Center">
                                <TextBlock Text="Customer:" VerticalAlignment="Center" FontSize="16" FontWeight="Bold" Foreground="#334155" Margin="0,0,6,0" />
                                <TextBox x:Name="historySearchCustomer" Width="120" Height="36" FontSize="16" FontWeight="Bold" VerticalContentAlignment="Center" Padding="4,2" TextChanged="historyFilter_Changed" ToolTip="Search by customer name" />
                            </StackPanel>

                            <!-- From Date Filter -->
                            <StackPanel Orientation="Horizontal" Margin="0,4,10,4" VerticalAlignment="Center">
                                <TextBlock Text="From:" VerticalAlignment="Center" FontSize="16" FontWeight="Bold" Foreground="#334155" Margin="0,0,6,0" />
                                <DatePicker x:Name="historyFromDatePicker" Width="135" Height="36" FontSize="15" FontWeight="Bold" VerticalContentAlignment="Center" SelectedDateChanged="historyFilter_Changed" ToolTip="Start date for filtering">
                                    <DatePicker.CalendarStyle>
                                        <Style TargetType="Calendar">
                                            <Setter Property="LayoutTransform">
                                                <Setter.Value>
                                                    <ScaleTransform ScaleX="1.5" ScaleY="1.5" />
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </DatePicker.CalendarStyle>
                                </DatePicker>
                            </StackPanel>

                            <!-- To Date Filter -->
                            <StackPanel Orientation="Horizontal" Margin="0,4,10,4" VerticalAlignment="Center">
                                <TextBlock Text="To:" VerticalAlignment="Center" FontSize="16" FontWeight="Bold" Foreground="#334155" Margin="0,0,6,0" />
                                <DatePicker x:Name="historyToDatePicker" Width="135" Height="36" FontSize="15" FontWeight="Bold" VerticalContentAlignment="Center" SelectedDateChanged="historyFilter_Changed" ToolTip="End date for filtering">
                                    <DatePicker.CalendarStyle>
                                        <Style TargetType="Calendar">
                                            <Setter Property="LayoutTransform">
                                                <Setter.Value>
                                                    <ScaleTransform ScaleX="1.5" ScaleY="1.5" />
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </DatePicker.CalendarStyle>
                                </DatePicker>
                            </StackPanel>

                            <!-- This Month Button -->
                            <Button x:Name="historyThisMonthBtn" Height="36" Padding="10,0" Margin="0,4,6,4" Content="This Month / پورا مہینہ" FontSize="14" FontWeight="Bold" Background="#EFF6FF" Foreground="#1E40AF" BorderBrush="#93C5FD" Click="historyThisMonth_Click" ToolTip="Filter for current month (1st to last day)" />

                            <!-- Clear Filters Button -->
                            <Button x:Name="historyClearFiltersBtn" Height="36" Padding="10,0" Margin="0,4,6,4" Content="Clear / صاف کریں" FontSize="14" FontWeight="Bold" Background="#F1F5F9" BorderBrush="#CBD5E1" Click="historyClearFilters_Click" ToolTip="Reset customer search and date filters" />

                            <!-- Print Selected Receipt Button -->
                            <Button x:Name="historyPrintSelectedBtn" Height="36" Padding="12,0" Margin="0,4,6,4" Content="Print Selected / پرنٹ" FontSize="14" FontWeight="Bold" Background="#0284C7" Foreground="#FFFFFF" BorderBrush="#0369A1" Click="historyPrintSelected_Click" ToolTip="Print exact receipt(s) of selected history record(s)" />

                            <!-- Records Count Text -->
                            <TextBlock x:Name="historyCountText" Text="Records: 0" VerticalAlignment="Center" FontSize="16" FontWeight="Bold" Foreground="#0284C7" Margin="6,4,0,4" />
                        </WrapPanel>
                    </Border>

                    <!-- DataGrid (GridView) -->
                    <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8">
                        <DataGrid x:Name="historyDataGrid"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserSortColumns="True"
                                  IsReadOnly="True"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#E2E8F0"
                                  VerticalGridLinesBrush="Transparent"
                                  RowHeight="42"
                                  FontSize="17"
                                  FontWeight="Bold"
                                  HeadersVisibility="Column"
                                  Background="#FFFFFF"
                                  AlternatingRowBackground="#F8FAFC"
                                  BorderThickness="0"
                                  SelectionMode="Extended"
                                  SelectionUnit="FullRow"
                                  MouseDoubleClick="historyDataGrid_MouseDoubleClick"
                                  PreviewKeyDown="historyDataGrid_PreviewKeyDown"
                                  SelectionChanged="historyDataGrid_SelectionChanged">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#F1F5F9" />
                                    <Setter Property="Foreground" Value="#334155" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                    <Setter Property="FontSize" Value="16" />
                                    <Setter Property="Height" Value="42" />
                                    <Setter Property="Padding" Value="4,0" />
                                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                                    <Setter Property="BorderBrush" Value="#CBD5E1" />
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.Columns>
                                <!-- Col 0: CheckBox Select -->
                                <DataGridTemplateColumn Width="46" CanUserSort="False">
                                    <DataGridTemplateColumn.Header>
                                        <CheckBox x:Name="historySelectAllHeaderCheckBox" 
                                                  Click="historySelectAllHeaderCheckBox_Click" 
                                                  ToolTip="Select / Deselect All Records" 
                                                  HorizontalAlignment="Center" 
                                                  VerticalAlignment="Center" />
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                      Click="historyRowCheckBox_Click"
                                                      HorizontalAlignment="Center" 
                                                      VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Col 1: Date & Time -->
                                <DataGridTextColumn Header="Date &amp; Time" Binding="{Binding FormattedDate}" Width="165" SortMemberPath="Timestamp">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="Padding" Value="4,0" />
                                            <Setter Property="FontWeight" Value="Bold" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Col 2: Customer Name -->
                                <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="110" SortMemberPath="CustomerName">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="Padding" Value="4,0" />
                                            <Setter Property="FontWeight" Value="Bold" />
                                            <Setter Property="Foreground" Value="#1E3A8A" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Col 3: Item (Metal & Type) -->
                                <DataGridTextColumn Header="Item" Binding="{Binding ItemDisplay}" Width="115" SortMemberPath="ItemDisplay">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="Padding" Value="4,0" />
                                            <Setter Property="FontWeight" Value="Bold" />
                                            <Setter Property="Foreground" Value="#B45309" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Col 4: Ratti -->
                                <DataGridTextColumn Header="Ratti" Binding="{Binding RattiDisplay}" Width="55" SortMemberPath="RattiValue">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="TextAlignment" Value="Center" />
                                            <Setter Property="Padding" Value="2,0" />
                                            <Setter Property="FontWeight" Value="Bold" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Col 5: Karat -->
                                <DataGridTextColumn Header="Karat" Binding="{Binding KaratDisplay}" Width="55" SortMemberPath="KaratValue">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="TextAlignment" Value="Center" />
                                            <Setter Property="Padding" Value="2,0" />
                                            <Setter Property="FontWeight" Value="Bold" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Col 6: Total Weight -->
                                <DataGridTextColumn Header="Total Wt" Binding="{Binding TotalWeightDisplay}" Width="85" SortMemberPath="TotalWeightValue">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="TextAlignment" Value="Right" />
                                            <Setter Property="Padding" Value="4,0" />
                                            <Setter Property="FontWeight" Value="Bold" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Col 7: Pure Gold -->
                                <DataGridTextColumn Header="Pure Gold" Binding="{Binding PureGoldDisplay}" Width="85" SortMemberPath="PureGoldValue">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="TextAlignment" Value="Right" />
                                            <Setter Property="Padding" Value="4,0" />
                                            <Setter Property="FontWeight" Value="Bold" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Col 8: Labor Charges -->
                                <DataGridTextColumn Header="Labor" Binding="{Binding LaborDisplay}" Width="60" SortMemberPath="LaborValue">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="TextAlignment" Value="Right" />
                                            <Setter Property="Padding" Value="4,0" />
                                            <Setter Property="FontWeight" Value="Bold" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Col 9: Cash Amount -->
                                <DataGridTextColumn Header="Cash (Rs)" Binding="{Binding CashDisplay}" Width="90" SortMemberPath="CashValue">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="TextAlignment" Value="Right" />
                                            <Setter Property="Padding" Value="4,0" />
                                            <Setter Property="FontWeight" Value="Bold" />
                                            <Setter Property="Foreground" Value="#059669" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Col 10: Gold Rate -->
                                <DataGridTextColumn Header="Gold Rate" Binding="{Binding GoldRateDisplay}" Width="85" SortMemberPath="GoldRateValue">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="TextAlignment" Value="Right" />
                                            <Setter Property="Padding" Value="4,0" />
                                            <Setter Property="FontWeight" Value="Bold" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Col 11: Notes / Status -->
                                <DataGridTextColumn Header="Notes" Binding="{Binding NotesDisplay}" Width="60" SortMemberPath="NotesDisplay">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="TextAlignment" Value="Center" />
                                            <Setter Property="Padding" Value="2,0" />
                                            <Setter Property="FontWeight" Value="Bold" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Col 12: Action Buttons (Open & Print) -->
                                <DataGridTemplateColumn Header="Action" Width="170">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Button Content="Open / کھولیں" 
                                                        Height="30" 
                                                        Padding="5,0" 
                                                        Margin="0,0,4,0" 
                                                        FontSize="12" 
                                                        FontWeight="Bold" 
                                                        Background="#059669" 
                                                        Foreground="#FFFFFF" 
                                                        BorderBrush="#047857" 
                                                        Click="historyRowOpen_Click" 
                                                        Tag="{Binding Id}" 
                                                        Cursor="Hand" 
                                                        VerticalAlignment="Center">
                                                    <Button.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="4"/>
                                                        </Style>
                                                    </Button.Resources>
                                                </Button>
                                                <Button Content="Print / پرنٹ" 
                                                        Height="30" 
                                                        Padding="5,0" 
                                                        FontSize="12" 
                                                        FontWeight="Bold" 
                                                        Background="#0284C7" 
                                                        Foreground="#FFFFFF" 
                                                        BorderBrush="#0369A1" 
                                                        Click="historyRowPrint_Click" 
                                                        Tag="{Binding Id}" 
                                                        Cursor="Hand" 
                                                        VerticalAlignment="Center">
                                                    <Button.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="4"/>
                                                        </Style>
                                                    </Button.Resources>
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Settings Tab -->
            <TabItem Header="Settings" x:Name="settingsTab" FontSize="38" FontWeight="Bold" Width="170" Background="#E0E7FF">
                <ScrollViewer Focusable="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="16" MaxWidth="800" HorizontalAlignment="Center">
                        <StackPanel Orientation="Vertical">

                            <!-- Section 1: Number of Slips Printed -->
                            <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,16">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Number of Slips Printed / پرنٹ کی کاپیاں" FontSize="20" FontWeight="Bold" Foreground="#1E3A8A" />
                                            <TextBlock Text="How many slips should be printed automatically when clicking Print (e.g. 1 for customer, 2 for customer + shop copy)." FontSize="14" FontWeight="Normal" Foreground="#64748B" TextWrapping="Wrap" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,8,0,10">
                                        <Button x:Name="btnDecreaseCopies" Content="−" Width="44" Height="44" FontSize="24" FontWeight="Bold" Background="#F1F5F9" BorderBrush="#CBD5E1" Click="btnDecreaseCopies_Click" ToolTip="Decrease copies" />
                                        <TextBox x:Name="txtSettingCopies" Width="70" Height="44" FontSize="22" FontWeight="Bold" TextAlignment="Center" VerticalContentAlignment="Center" Text="2" IsReadOnly="True" Background="#F8FAFC" BorderBrush="#CBD5E1" Margin="8,0" />
                                        <Button x:Name="btnIncreaseCopies" Content="+" Width="44" Height="44" FontSize="24" FontWeight="Bold" Background="#F1F5F9" BorderBrush="#CBD5E1" Click="btnIncreaseCopies_Click" ToolTip="Increase copies" />

                                        <!-- Quick Presets -->
                                        <Button Content="1 Copy / ایک کاپی" Height="40" Padding="12,0" Margin="24,0,8,0" FontSize="14" FontWeight="Bold" Background="#F1F5F9" BorderBrush="#CBD5E1" Click="btnPresetCopies_Click" Tag="1" />
                                        <Button Content="2 Copies / دو کاپیاں" Height="40" Padding="12,0" Margin="0,0,8,0" FontSize="14" FontWeight="Bold" Background="#E0F2FE" Foreground="#0369A1" BorderBrush="#0284C7" Click="btnPresetCopies_Click" Tag="2" />
                                        <Button Content="3 Copies / تین کاپیاں" Height="40" Padding="12,0" Margin="0,0,0,0" FontSize="14" FontWeight="Bold" Background="#F1F5F9" BorderBrush="#CBD5E1" Click="btnPresetCopies_Click" Tag="3" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Section 2: Slip Size Setting -->
                            <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Thermal Printer Slip Size / پرنٹ سائز" FontSize="20" FontWeight="Bold" Foreground="#1E3A8A" />
                                    <TextBlock Text="Choose paper width for your thermal receipt printer. Changes apply to both Single and Multi Test receipts." FontSize="14" FontWeight="Normal" Foreground="#64748B" TextWrapping="Wrap" Margin="0,2,0,10" />

                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Large 80mm Option -->
                                        <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="2" CornerRadius="8" Padding="14,12">
                                            <RadioButton x:Name="radioSettingsSlipLarge" GroupName="SettingsSlipSize" IsChecked="True" Checked="settingsSlipSize_Checked" VerticalAlignment="Center">
                                                <StackPanel Margin="6,0,0,0">
                                                    <TextBlock Text="Large Print (80mm / 3.15&quot;)" FontSize="16" FontWeight="Bold" Foreground="#1E293B" />
                                                    <TextBlock Text="Standard 3-inch thermal printer (بڑا سائز)" FontSize="13" FontWeight="Normal" Foreground="#64748B" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </RadioButton>
                                        </Border>

                                        <!-- Small 58mm Option -->
                                        <Border Grid.Column="2" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="2" CornerRadius="8" Padding="14,12">
                                            <RadioButton x:Name="radioSettingsSlipSmall" GroupName="SettingsSlipSize" Checked="settingsSlipSize_Checked" VerticalAlignment="Center">
                                                <StackPanel Margin="6,0,0,0">
                                                    <TextBlock Text="Small Print (58mm / 2.28&quot;)" FontSize="16" FontWeight="Bold" Foreground="#1E293B" />
                                                    <TextBlock Text="Compact 2-inch thermal printer (چھوٹا سائز)" FontSize="13" FontWeight="Normal" Foreground="#64748B" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </RadioButton>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Section 3: Font Size Increase / Decrease -->
                            <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Font Size Adjustment / فونٹ کا سائز" FontSize="20" FontWeight="Bold" Foreground="#1E3A8A" />
                                    <TextBlock Text="Scale text larger or smaller across software screens and printed receipts." FontSize="14" FontWeight="Normal" Foreground="#64748B" TextWrapping="Wrap" Margin="0,2,0,10" />

                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,12">
                                        <Button x:Name="btnDecreaseFontSize" Content="A− Smaller / چھوٹا" Height="42" Padding="14,0" Margin="0,0,10,0" FontSize="15" FontWeight="Bold" Background="#F1F5F9" BorderBrush="#CBD5E1" Click="btnDecreaseFontSize_Click" ToolTip="Decrease font size by 1px" />
                                        <Button x:Name="btnResetFontSize" Content="Default (0px) / اصل سائز" Height="42" Padding="14,0" Margin="0,0,10,0" FontSize="15" FontWeight="Bold" Background="#EFF6FF" Foreground="#1E40AF" BorderBrush="#93C5FD" Click="btnResetFontSize_Click" ToolTip="Reset font size to default" />
                                        <Button x:Name="btnIncreaseFontSize" Content="A+ Larger / بڑا" Height="42" Padding="14,0" Margin="0,0,16,0" FontSize="15" FontWeight="Bold" Background="#F1F5F9" BorderBrush="#CBD5E1" Click="btnIncreaseFontSize_Click" ToolTip="Increase font size by 1px" />

                                        <Border Background="#F1F5F9" CornerRadius="6" Padding="12,6" VerticalAlignment="Center">
                                            <TextBlock x:Name="txtSettingFontSizeDelta" Text="Current: Normal (0px)" FontSize="15" FontWeight="Bold" Foreground="#0284C7" />
                                        </Border>
                                    </StackPanel>

                                    <!-- Live Sample Preview -->
                                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12,8">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Preview / نمونہ: " FontSize="14" FontWeight="Bold" Foreground="#64748B" VerticalAlignment="Center" />
                                            <TextBlock x:Name="txtSettingSamplePreview" Text="Instant Dealing — Gold 10.500g — Result 92.5 Ratti — خالص سونا" FontSize="16" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Section 4: Bold / Unbold Option -->
                            <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Bold / Regular Text / تحریر کی موٹائی (بولڈ)" FontSize="20" FontWeight="Bold" Foreground="#1E3A8A" />
                                    <TextBlock Text="Toggle between extra-bold high visibility font and regular weight font." FontSize="14" FontWeight="Normal" Foreground="#64748B" TextWrapping="Wrap" Margin="0,2,0,10" />

                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="2" CornerRadius="8" Padding="16,10" Margin="0,0,16,0">
                                            <RadioButton x:Name="radioSettingBold" GroupName="SettingsBoldOption" IsChecked="True" Checked="settingsBold_Checked" VerticalAlignment="Center">
                                                <TextBlock Text="Bold (Default) / بولڈ تحریر" FontSize="16" FontWeight="Bold" Foreground="#1E293B" Margin="6,0,0,0" />
                                            </RadioButton>
                                        </Border>

                                        <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="2" CornerRadius="8" Padding="16,10">
                                            <RadioButton x:Name="radioSettingRegular" GroupName="SettingsBoldOption" Checked="settingsBold_Checked" VerticalAlignment="Center">
                                                <TextBlock Text="Regular / عام تحریر" FontSize="16" FontWeight="Normal" Foreground="#1E293B" Margin="6,0,0,0" />
                                            </RadioButton>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Section 5: Save Settings & Status -->
                            <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="12" Padding="18">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Button x:Name="btnSaveSettings" Grid.Column="0" Content="Save Settings / ترتیبات محفوظ کریں" Height="46" Padding="20,0" FontSize="16" FontWeight="Bold" Background="#059669" Foreground="#FFFFFF" BorderBrush="#047857" Click="btnSaveSettings_Click" />
                                    <Button x:Name="btnRestoreSettingsDefaults" Grid.Column="2" Content="Restore Defaults / پہلے والی حالت" Height="46" Padding="18,0" FontSize="15" FontWeight="Bold" Background="#F1F5F9" BorderBrush="#CBD5E1" Click="btnRestoreSettingsDefaults_Click" />

                                    <TextBlock x:Name="txtSettingsStatus" Grid.Column="4" Text="" FontSize="15" FontWeight="Bold" Foreground="#059669" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Bottom Buttons Bar -->
        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Height="52" VerticalAlignment="Center" Name="ClearButton" Click="ClearButton_Click" Background="#F1F5F9" BorderBrush="#CBD5E1">
                <TextBlock FontSize="20" VerticalAlignment="Center" Foreground="#334155" FontWeight="Bold">
                    <Run Text="Clear / " FontWeight="Bold" />
                    <Run Text="کلیئر" FontFamily="./font/#Alvi Nastaleeq Regular" FontSize="24" FontWeight="Bold" />
                </TextBlock>
            </Button>

            <Button Grid.Column="2" Height="52" VerticalAlignment="Center" Name="SelectAllButton" Click="SelectAllCheckBoxes_Click" Background="#E0F2FE" BorderBrush="#0284C7">
                <TextBlock FontSize="20" VerticalAlignment="Center" Foreground="#0369A1" FontWeight="Bold">
                    <Run Text="Select All / " FontWeight="Bold" />
                    <Run Text="تمام منتخب" FontFamily="./font/#Alvi Nastaleeq Regular" FontSize="24" FontWeight="Bold" />
                </TextBlock>
            </Button>

            <Button Grid.Column="4" Height="52" VerticalAlignment="Center" Name="DeselectAllButton" Click="DeselectAllCheckBoxes_Click" Background="#F1F5F9" BorderBrush="#94A3B8">
                <TextBlock FontSize="20" VerticalAlignment="Center" Foreground="#475569" FontWeight="Bold">
                    <Run Text="Deselect All / " FontWeight="Bold" />
                    <Run Text="تمام غیر منتخب" FontFamily="./font/#Alvi Nastaleeq Regular" FontSize="24" FontWeight="Bold" />
                </TextBlock>
            </Button>

            <Button Grid.Column="6" Height="52" VerticalAlignment="Center" Name="SaveButton" Click="SaveButton_Click" Background="#0284C7" BorderBrush="#0369A1">
                <TextBlock x:Name="saveButtonText" FontSize="20" VerticalAlignment="Center" Foreground="#FFFFFF" FontWeight="Bold">
                    <Run Text="Print / " FontWeight="Bold" />
                    <Run Text="پرنٹ" FontFamily="./font/#Alvi Nastaleeq Regular" FontSize="24" FontWeight="Bold" />
                </TextBlock>
            </Button>
        </Grid>
    </Grid>
</Window>

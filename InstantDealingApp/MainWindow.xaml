<Window x:Class="InstantDealingApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:InstantDealingApp"
        mc:Ignorable="d"
        Title="Instant Dealing" Width="780" MinWidth="600"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <!-- Custom Style for High-Contrast, Larger CheckBoxes -->
        <Style TargetType="CheckBox">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Border x:Name="Border" 
                                    Width="26" Height="26" 
                                    CornerRadius="5" 
                                    Background="#F1F5F9" 
                                    BorderBrush="#64748B" 
                                    BorderThickness="2"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                <Path x:Name="CheckMark" 
                                      Width="15" Height="12" 
                                      SnapsToDevicePixels="True" 
                                      Data="M 2,6 L 6,10 L 13,2" 
                                      Stroke="#FFFFFF" 
                                      StrokeThickness="3" 
                                      Visibility="Collapsed"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#0284C7"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#0369A1"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter TargetName="Border" Property="Background" Value="#F1F5F9"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#64748B"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#0284C7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom Style for High-Visibility Active Focused TextBoxes -->
        <Style TargetType="TextBox">
            <Setter Property="CaretBrush" Value="#0F172A"/>
            <Setter Property="Padding" Value="6,4,6,4"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#0284C7"/>
                    <Setter Property="BorderThickness" Value="2.5"/>
                    <Setter Property="Background" Value="#EFF6FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.LayoutTransform>
            <ScaleTransform ScaleX="0.65" ScaleY="0.65" />
        </Grid.LayoutTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Tab Control -->
        <TabControl x:Name="mainTabControl" Grid.Row="0" SelectionChanged="TabControl_SelectionChanged">

            <!-- Test Tab (First Tab) -->
            <TabItem Header="Test" x:Name="testTab" FontSize="36" Width="100">
                <ScrollViewer Focusable="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid VerticalAlignment="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50*" MinWidth="420" />
                            <ColumnDefinition Width="50*" MinWidth="420" />
                        </Grid.ColumnDefinitions>

                        <!-- Left Section (50% Width) -->
                        <Grid Grid.Column="0" Margin="12,12,6,12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="240" MaxWidth="320" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="40" />
                            </Grid.ColumnDefinitions>

                            <!-- Today Gold Rate (Shared with Difference Field) -->
                            <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" FontSize="22" Margin="0,4,8,4">
                                <Run Text="Today Gold Rate / " />
                                <Run Text="آج کا ریٹ:" FontFamily="./font/#Alvi Nastaleeq Regular" FontSize="26" />
                            </TextBlock>
                            <Grid Grid.Row="0" Grid.Column="1" Margin="0,4,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="90" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="goldRateTextboxTest" Grid.Column="0" LostFocus="goldRateTextbox_LostFocus" HorizontalAlignment="Stretch" FontSize="18" Height="40" PreviewTextInput="labTextbox_PreviewTextInput" Text="0" GotFocus="clearOnFocus" TextChanged="goldRateTextbox_TextChanged" TextBlock.FontSize="24"/>
                                <TextBlock Grid.Column="1" Text="-" VerticalAlignment="Center" FontSize="22" FontWeight="Bold" Margin="6,0,6,0" Foreground="#64748B" />
                                <TextBox x:Name="goldRateDiffTextbox" Grid.Column="2" FontSize="18" Height="40" PreviewTextInput="labTextbox_PreviewTextInput" Text="0" GotFocus="clearOnFocus" TextChanged="goldRateDiffTextbox_TextChanged" TextBlock.FontSize="24" ToolTip="Subtracted Amount from Gold Rate" HorizontalContentAlignment="Center"/>
                            </Grid>
                            <CheckBox IsChecked="false" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" FontSize="18" HorizontalAlignment="Center" Name="doPrintGoldRateTest" Click="PrintCheckBox_Click" IsTabStop="False"/>

                            <!-- Select Customer -->
                            <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" FontSize="22" Margin="0,4,8,4">
                                <Run Text="Select Customer / " />
                                <Run Text="کسٹمر:" FontFamily="./font/#Alvi Nastaleeq Regular" FontSize="26" />
                            </TextBlock>
                            <ComboBox x:Name="customersTest" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Margin="0,4,0,4" FontSize="18" Height="40" IsEditable="True" LostFocus="customersComboBox_LostFocus" GotFocus="customers_GotFocus" SelectionChanged="customersComboBox_SelectionChanged" TextBlock.FontSize="24">
                                <!-- ComboBox items go here -->
                            </ComboBox>
                            <CheckBox IsChecked="true" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" FontSize="18" HorizontalAlignment="Center" Name="doPrintCustomerNameTest" Click="PrintCheckBox_Click" IsTabStop="False"/>

                            <!-- Total Weight -->
                            <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" FontSize="22" Margin="0,4,8,4">
                                <Run Text="Total Weight / " />
                                <Run Text="کل وزن:" FontFamily="./font/#Alvi Nastaleeq Regular" FontSize="26" />
                            </TextBlock>
                            <TextBox x:Name="totalWeightTextbox" Grid.Row="2" Grid.Column="1" FontSize="18" Height="40" Margin="0,4,0,4" KeyDown="cashTextbox_KeyDown" PreviewTextInput="labTextbox_PreviewTextInput" VerticalAlignment="Center" Text="0" TextChanged="testTabInputs_TextChanged" GotFocus="clearOnFocus" TextBlock.FontSize="24"/>
                            <CheckBox IsChecked="true" Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" FontSize="18" HorizontalAlignment="Center" x:Name="doPrintTotalWeight" Click="PrintCheckBox_Click" TextBlock.FontSize="24" IsTabStop="False"/>

                            <!-- Result -->
                            <TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" FontSize="22" Margin="0,4,8,4">
                                <Run Text="Result (Ratti) / " />
                                <Run Text="رزلٹ:" FontFamily="./font/#Alvi Nastaleeq Regular" FontSize="26" />
                            </TextBlock>
                            <TextBox x:Name="resultTextbox" Grid.Row="3" Grid.Column="1" FontSize="18" Height="40" Margin="0,4,0,4" KeyDown="cashTextbox_KeyDown" PreviewTextInput="labTextbox_PreviewTextInput" VerticalAlignment="Center" Text="0" TextChanged="testTabInputs_TextChanged" GotFocus="clearOnFocus" TextBlock.FontSize="24"/>
                            <CheckBox IsChecked="true" Grid.Row="3" Grid.Column="2" VerticalAlignment="Center" FontSize="18" HorizontalAlignment="Center" x:Name="doPrintResult" Click="PrintCheckBox_Click" TextBlock.FontSize="24" IsTabStop="False"/>

                            <!-- Pure Gold (Calculated & Read-Only) -->
                            <TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" FontSize="22" Margin="0,4,8,4">
                                <Run Text="Pure Gold / " />
                                <Run Text="خالص سونا:" FontFamily="./font/#Alvi Nastaleeq Regular" FontSize="26" />
                            </TextBlock>
                            <TextBox x:Name="pureGoldTextbox" Grid.Row="4" Grid.Column="1" FontSize="18" Height="40" Margin="0,4,0,4" IsReadOnly="True" Focusable="False" IsTabStop="False" Background="#F0F0F0" VerticalAlignment="Center" Text="0" TextBlock.FontSize="24"/>
                            <CheckBox IsChecked="true" Grid.Row="4" Grid.Column="2" VerticalAlignment="Center" FontSize="18" HorizontalAlignment="Center" x:Name="doPrintPureGold" Click="PrintCheckBox_Click" TextBlock.FontSize="24" IsTabStop="False"/>

                            <!-- Labor Charges (Row 5) -->
                            <TextBlock Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" FontSize="22" Margin="0,4,8,4">
                                <Run Text="Labor Charges / " />
                                <Run Text="مزدوری:" FontFamily="./font/#Alvi Nastaleeq Regular" FontSize="26" />
                            </TextBlock>
                            <TextBox x:Name="laborTextbox" Grid.Row="5" Grid.Column="1" FontSize="18" Height="40" Margin="0,4,0,4" KeyDown="cashTextbox_KeyDown" PreviewTextInput="labTextbox_PreviewTextInput" VerticalAlignment="Center" Text="0" TextChanged="laborTextbox_TextChanged" GotFocus="clearOnFocus" LostFocus="laborTextbox_LostFocus" TextBlock.FontSize="24"/>
                            <CheckBox IsChecked="true" Grid.Row="5" Grid.Column="2" VerticalAlignment="Center" FontSize="18" HorizontalAlignment="Center" x:Name="doPrintLabor" Click="PrintCheckBox_Click" TextBlock.FontSize="24" IsTabStop="False"/>

                            <!-- Bottom Calculated Cards Section (Row 6): 2 Cards (Cash Without Labor & Cash With Labor) -->
                            <Grid Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,15,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Box 1 (Col 0): Cash Without Labor (Gross Cash) -->
                                <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1.5" CornerRadius="10" Padding="8,8,8,8">
                                    <StackPanel>
                                        <TextBlock TextAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,6">
                                            <Run Text="Cash Without Labor / " FontSize="13.5" FontWeight="Bold" Foreground="#334155" />
                                            <Run Text="کیش - بغیر مزدوری" FontFamily="./font/#Alvi Nastaleeq Regular" FontSize="17" Foreground="#334155" />
                                        </TextBlock>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="grossPureGoldCashTextbox" Grid.Column="0" FontSize="20" Height="42" IsReadOnly="True" Focusable="False" IsTabStop="False" Background="#FFFFFF" VerticalAlignment="Center" Text="0" TextAlignment="Center" TextBlock.FontSize="24"/>
                                            <CheckBox x:Name="doPrintGrossPureGoldCash" Grid.Column="1" IsChecked="False" VerticalAlignment="Center" Margin="6,0,0,0" Click="PrintCheckBox_Click" IsTabStop="False"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Box 2 (Col 2): Cash With Labor (Total Pure Gold Cash) -->
                                <Border Grid.Column="2" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1.5" CornerRadius="10" Padding="8,8,8,8">
                                    <StackPanel>
                                        <TextBlock TextAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,6">
                                            <Run Text="Cash With Labor / " FontSize="13.5" FontWeight="Bold" Foreground="#334155" />
                                            <Run Text="کیش - بمعہ مزدوری" FontFamily="./font/#Alvi Nastaleeq Regular" FontSize="17" Foreground="#334155" />
                                        </TextBlock>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="totalPureGoldCashTextbox" Grid.Column="0" FontSize="20" Height="42" IsReadOnly="True" Focusable="False" IsTabStop="False" Background="#FFFFFF" Foreground="#FF008A2E" FontWeight="Bold" VerticalAlignment="Center" Text="0" TextAlignment="Center" TextBlock.FontSize="24"/>
                                            <CheckBox x:Name="doPrintTotalPureGoldCash" Grid.Column="1" IsChecked="True" VerticalAlignment="Center" Margin="6,0,0,0" Click="PrintCheckBox_Click" IsTabStop="False"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>

                        <!-- Right Section: Top Row (Sample & Result Weight) + Karat/Ratti Row + Purity % Row + Notes Card (Bottom) -->
                        <Grid Grid.Column="1" Margin="6,12,12,12" VerticalAlignment="Top">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="6" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="6" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="6" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Row 0: Sample Weight & Result Weight -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="sampleWeightTextbox" Grid.Column="0" FontSize="18" Height="40" PreviewTextInput="labTextbox_PreviewTextInput" GotFocus="clearOnFocus" KeyDown="cashTextbox_KeyDown" TextChanged="sampleResultWeight_TextChanged" TextBlock.FontSize="22" HorizontalContentAlignment="Center" ToolTip="Sample Weight" Text="0"/>
                                <TextBox x:Name="resultWeightTextbox" Grid.Column="2" FontSize="18" Height="40" PreviewTextInput="labTextbox_PreviewTextInput" GotFocus="clearOnFocus" KeyDown="cashTextbox_KeyDown" TextChanged="sampleResultWeight_TextChanged" TextBlock.FontSize="22" HorizontalContentAlignment="Center" ToolTip="Result Weight" Text="0"/>
                            </Grid>

                            <!-- Row 2: Karat <-> Ratti Conversion (With Labels) -->
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Karat Input Stack -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock HorizontalAlignment="Center" Margin="0,0,0,4" FontSize="14" FontWeight="Bold" Foreground="#334155">
                                        <Run Text="Karat / " />
                                        <Run Text="کیرٹ" FontFamily="./font/#Alvi Nastaleeq Regular" FontSize="18" />
                                    </TextBlock>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="karatInputTextbox" Grid.Column="0" FontSize="18" Height="40" PreviewTextInput="labTextbox_PreviewTextInput" GotFocus="clearOnFocus" KeyDown="cashTextbox_KeyDown" TextChanged="karatInputTextbox_TextChanged" TextBlock.FontSize="22" HorizontalContentAlignment="Center" ToolTip="Karat (0 = No Gold, 24 = Pure Gold)" Text="0"/>
                                        <CheckBox x:Name="doPrintKarat" Grid.Column="1" IsChecked="False" VerticalAlignment="Center" Margin="6,0,0,0" Click="PrintCheckBox_Click" IsTabStop="False"/>
                                    </Grid>
                                </StackPanel>

                                <!-- Ratti Conversion Stack -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock HorizontalAlignment="Center" Margin="0,0,0,4" FontSize="14" FontWeight="Bold" Foreground="#334155">
                                        <Run Text="Ratti / " />
                                        <Run Text="رتی" FontFamily="./font/#Alvi Nastaleeq Regular" FontSize="18" />
                                    </TextBlock>
                                    <TextBox x:Name="rattiConversionTextbox" FontSize="18" Height="40" PreviewTextInput="labTextbox_PreviewTextInput" GotFocus="clearOnFocus" KeyDown="cashTextbox_KeyDown" TextChanged="rattiConversionTextbox_TextChanged" TextBlock.FontSize="22" HorizontalContentAlignment="Center" ToolTip="Ratti (0 = Pure Gold, 96 = No Gold)" Text="0"/>
                                </StackPanel>
                            </Grid>

                            <!-- Row 4: Purity % <-> Ratti Conversion (With Labels) -->
                            <Grid Grid.Row="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Purity % Input Stack -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock HorizontalAlignment="Center" Margin="0,0,0,4" FontSize="14" FontWeight="Bold" Foreground="#334155">
                                        <Run Text="Purity % / " />
                                        <Run Text="فیصد خالص" FontFamily="./font/#Alvi Nastaleeq Regular" FontSize="18" />
                                    </TextBlock>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="purityPercentTextbox" Grid.Column="0" FontSize="18" Height="40" PreviewTextInput="labTextbox_PreviewTextInput" GotFocus="clearOnFocus" KeyDown="cashTextbox_KeyDown" TextChanged="purityPercentTextbox_TextChanged" TextBlock.FontSize="22" HorizontalContentAlignment="Center" ToolTip="Purity % (100% = Pure Gold, 0% = No Gold)" Text="0"/>
                                        <CheckBox x:Name="doPrintPurityPercent" Grid.Column="1" IsChecked="False" VerticalAlignment="Center" Margin="6,0,0,0" Click="PrintCheckBox_Click" IsTabStop="False"/>
                                    </Grid>
                                </StackPanel>

                                <!-- Purity Ratti Result Stack -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock HorizontalAlignment="Center" Margin="0,0,0,4" FontSize="14" FontWeight="Bold" Foreground="#334155">
                                        <Run Text="Ratti / " />
                                        <Run Text="رتی" FontFamily="./font/#Alvi Nastaleeq Regular" FontSize="18" />
                                    </TextBlock>
                                    <TextBox x:Name="purityRattiResultTextbox" FontSize="18" Height="40" PreviewTextInput="labTextbox_PreviewTextInput" GotFocus="clearOnFocus" KeyDown="cashTextbox_KeyDown" TextChanged="purityRattiResultTextbox_TextChanged" TextBlock.FontSize="22" HorizontalContentAlignment="Center" ToolTip="Ratti Result" Text="0"/>
                                </StackPanel>
                            </Grid>

                            <!-- Notes Card Container (Row 6) -->
                            <Border Grid.Row="6" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1.5" CornerRadius="10" Padding="12,10,12,10" VerticalAlignment="Top">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!-- Row 0: Header with Title and Print CheckBox -->
                                    <Grid Grid.Row="0" Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="20" FontWeight="Bold" Foreground="#334155">
                                            <Run Text="Notes / " />
                                            <Run Text="نوٹ:" FontFamily="./font/#Alvi Nastaleeq Regular" FontSize="24" />
                                        </TextBlock>
                                        <CheckBox x:Name="doPrintNotes" Grid.Column="1" IsChecked="True" VerticalAlignment="Center" Click="PrintCheckBox_Click" IsTabStop="False" ToolTip="Print Notes on Receipt" />
                                    </Grid>

                                    <!-- Row 1: Multiline Notes TextBox -->
                                    <TextBox x:Name="notesTextboxTest" Grid.Row="1" FontSize="18" Height="170"
                                             AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                             Padding="8" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1"
                                             TextChanged="notesTextboxTest_TextChanged"
                                             TextBlock.FontSize="22" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- History Tab -->
            <TabItem Header="History" x:Name="historyTab" FontSize="36" Width="140" Background="#BAE6FD">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Top Filter Bar -->
                    <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="12,10,12,10" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Customer Filter -->
                            <TextBlock Grid.Column="0" Text="Customer:" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,8,0" />
                            <TextBox x:Name="historySearchCustomer" Grid.Column="1" Height="38" FontSize="16" VerticalContentAlignment="Center" Padding="6,2" TextChanged="historyFilter_Changed" ToolTip="Search by customer name" />

                            <!-- Date Filter -->
                            <TextBlock Grid.Column="3" Text="Date:" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,8,0" />
                            <DatePicker x:Name="historyDatePicker" Grid.Column="4" Height="38" FontSize="16" VerticalContentAlignment="Center" SelectedDateChanged="historyFilter_Changed" ToolTip="Filter by date">
                                <DatePicker.CalendarStyle>
                                    <Style TargetType="Calendar">
                                        <Setter Property="LayoutTransform">
                                            <Setter.Value>
                                                <ScaleTransform ScaleX="1.6" ScaleY="1.6" />
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </DatePicker.CalendarStyle>
                            </DatePicker>

                            <!-- Clear Filters Button -->
                            <Button x:Name="historyClearFiltersBtn" Grid.Column="6" Height="38" Padding="16,0" Content="Clear Filters" FontSize="14" FontWeight="SemiBold" Background="#F1F5F9" BorderBrush="#CBD5E1" Click="historyClearFilters_Click" />

                            <!-- Print Selected Receipt Button -->
                            <Button x:Name="historyPrintSelectedBtn" Grid.Column="8" Height="38" Padding="16,0" Content="Print Receipt / پرنٹ" FontSize="14" FontWeight="Bold" Background="#0284C7" Foreground="#FFFFFF" BorderBrush="#0369A1" Click="historyPrintSelected_Click" ToolTip="Print exact receipt of selected history record" />

                            <!-- Records Count Text -->
                            <TextBlock x:Name="historyCountText" Grid.Column="10" Text="Records: 0" VerticalAlignment="Center" FontSize="16" FontWeight="Bold" Foreground="#0284C7" />
                        </Grid>
                    </Border>

                    <!-- DataGrid (GridView) -->
                    <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8">
                        <DataGrid x:Name="historyDataGrid"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserSortColumns="True"
                                  IsReadOnly="True"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#E2E8F0"
                                  VerticalGridLinesBrush="Transparent"
                                  RowHeight="38"
                                  FontSize="15"
                                  HeadersVisibility="Column"
                                  Background="#FFFFFF"
                                  AlternatingRowBackground="#F8FAFC"
                                  BorderThickness="0"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  MouseDoubleClick="historyDataGrid_MouseDoubleClick"
                                  PreviewKeyDown="historyDataGrid_PreviewKeyDown"
                                  SelectionChanged="historyDataGrid_SelectionChanged">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#F1F5F9" />
                                    <Setter Property="Foreground" Value="#334155" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="FontSize" Value="15" />
                                    <Setter Property="Height" Value="40" />
                                    <Setter Property="Padding" Value="10,0" />
                                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                                    <Setter Property="BorderBrush" Value="#CBD5E1" />
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.Columns>
                                <!-- Col 1: Date & Time -->
                                <DataGridTextColumn Header="Date &amp; Time" Binding="{Binding FormattedDate}" Width="170" SortMemberPath="Timestamp">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="Padding" Value="8,0" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Col 2: Customer Name -->
                                <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="150" SortMemberPath="CustomerName">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="Padding" Value="8,0" />
                                            <Setter Property="FontWeight" Value="Bold" />
                                            <Setter Property="Foreground" Value="#1E3A8A" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Col 3: Ratti -->
                                <DataGridTextColumn Header="Ratti" Binding="{Binding RattiDisplay}" Width="85" SortMemberPath="RattiValue">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="TextAlignment" Value="Center" />
                                            <Setter Property="Padding" Value="4,0" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Col 4: Karat -->
                                <DataGridTextColumn Header="Karat" Binding="{Binding KaratDisplay}" Width="85" SortMemberPath="KaratValue">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="TextAlignment" Value="Center" />
                                            <Setter Property="Padding" Value="4,0" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Col 6: Total Weight -->
                                <DataGridTextColumn Header="Total Wt" Binding="{Binding TotalWeightDisplay}" Width="110" SortMemberPath="TotalWeightValue">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="TextAlignment" Value="Right" />
                                            <Setter Property="Padding" Value="8,0" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Col 7: Pure Gold -->
                                <DataGridTextColumn Header="Pure Gold" Binding="{Binding PureGoldDisplay}" Width="110" SortMemberPath="PureGoldValue">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="TextAlignment" Value="Right" />
                                            <Setter Property="Padding" Value="8,0" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Col 8: Labor Charges -->
                                <DataGridTextColumn Header="Labor (Rs)" Binding="{Binding LaborDisplay}" Width="100" SortMemberPath="LaborValue">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="TextAlignment" Value="Right" />
                                            <Setter Property="Padding" Value="8,0" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Col 9: Cash Amount -->
                                <DataGridTextColumn Header="Cash (Rs)" Binding="{Binding CashDisplay}" Width="120" SortMemberPath="CashValue">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="TextAlignment" Value="Right" />
                                            <Setter Property="Padding" Value="8,0" />
                                            <Setter Property="FontWeight" Value="Bold" />
                                            <Setter Property="Foreground" Value="#059669" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Col 10: Gold Rate -->
                                <DataGridTextColumn Header="Gold Rate" Binding="{Binding GoldRateDisplay}" Width="110" SortMemberPath="GoldRateValue">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="TextAlignment" Value="Right" />
                                            <Setter Property="Padding" Value="8,0" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Col 11: Notes / Status -->
                                <DataGridTextColumn Header="Notes / Status" Binding="{Binding NotesDisplay}" Width="*" SortMemberPath="NotesDisplay">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="Padding" Value="8,0" />
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Col 12: Action Print -->
                                <DataGridTemplateColumn Header="Action" Width="105">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Print / پرنٹ" 
                                                    Height="28" 
                                                    Padding="8,0" 
                                                    FontSize="12" 
                                                    FontWeight="Bold" 
                                                    Background="#0284C7" 
                                                    Foreground="#FFFFFF" 
                                                    BorderBrush="#0369A1" 
                                                    Click="historyRowPrint_Click" 
                                                    Tag="{Binding Id}" 
                                                    Cursor="Hand"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Center">
                                                <Button.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="4"/>
                                                    </Style>
                                                </Button.Resources>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Bottom Buttons Bar -->
        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Height="48" VerticalAlignment="Center" Name="ClearButton" Click="ClearButton_Click" Background="#F1F5F9" BorderBrush="#CBD5E1">
                <TextBlock FontSize="18" VerticalAlignment="Center" Foreground="#334155">
                    <Run Text="Clear / " />
                    <Run Text="کلیئر" FontFamily="./font/#Alvi Nastaleeq Regular" FontSize="22" />
                </TextBlock>
            </Button>

            <Button Grid.Column="2" Height="48" VerticalAlignment="Center" Name="SelectAllButton" Click="SelectAllCheckBoxes_Click" Background="#E0F2FE" BorderBrush="#0284C7">
                <TextBlock FontSize="18" VerticalAlignment="Center" Foreground="#0369A1" FontWeight="Bold">
                    <Run Text="Select All / " />
                    <Run Text="تمام منتخب" FontFamily="./font/#Alvi Nastaleeq Regular" FontSize="22" />
                </TextBlock>
            </Button>

            <Button Grid.Column="4" Height="48" VerticalAlignment="Center" Name="DeselectAllButton" Click="DeselectAllCheckBoxes_Click" Background="#F1F5F9" BorderBrush="#94A3B8">
                <TextBlock FontSize="18" VerticalAlignment="Center" Foreground="#475569" FontWeight="Bold">
                    <Run Text="Deselect All / " />
                    <Run Text="تمام غیر منتخب" FontFamily="./font/#Alvi Nastaleeq Regular" FontSize="22" />
                </TextBlock>
            </Button>

            <Button Grid.Column="6" Height="48" VerticalAlignment="Center" Name="SaveButton" Click="SaveButton_Click" Background="#0284C7" BorderBrush="#0369A1">
                <TextBlock x:Name="saveButtonText" FontSize="18" VerticalAlignment="Center" Foreground="#FFFFFF" FontWeight="Bold">
                    <Run Text="Print / " />
                    <Run Text="پرنٹ" FontFamily="./font/#Alvi Nastaleeq Regular" FontSize="22" />
                </TextBlock>
            </Button>
        </Grid>
    </Grid>
</Window>

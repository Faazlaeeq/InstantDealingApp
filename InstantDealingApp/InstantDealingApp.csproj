<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>app_icon.ico</ApplicationIcon>
  </PropertyGroup>

    <ItemGroup>
	    <None Remove="customer.json" />
	    <None Remove="font\Alvi Nastaleeq Regular.ttf" />
	    <None Remove="imgGive_gold.jpg" />
	    <None Remove="imgGive_money.jpg" />
	    <None Remove="imgTake_gold.jpg" />
	    <None Remove="imgTake_money1.jpg" />
	    <None Remove="img\imgGive_gold.jpg" />
	    <None Remove="img\imgGive_money1.jpg" />
	    <None Remove="img\imgTake_gold1.jpg" />
	    <None Remove="img\imgTake_money1.jpg" />
	    <None Remove="Screenshot 2024-11-02 012151.png" />
    </ItemGroup>

    <ItemGroup>
      <Content Include="customer.json">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <Content Include="print_history.json">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    </ItemGroup>

    <ItemGroup>
      <Resource Include="imgGive_gold.jpg" />
      <Resource Include="imgGive_money.jpg" />
      <Resource Include="imgTake_gold.jpg" />
      <Resource Include="imgTake_money1.jpg" />
    </ItemGroup>

    <ItemGroup>
      <Resource Include="img\imgGive_gold.jpg">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </Resource>
    </ItemGroup>

    <ItemGroup>
      <Resource Include="app_icon.ico">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Resource>
      <Resource Include="font\Alvi Nastaleeq Regular.ttf">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Resource>
      <Resource Include="img\imgTake_gold1.jpg">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </Resource>
      <Resource Include="img\imgTake_money1.jpg">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </Resource>
      <Resource Include="Screenshot 2024-11-02 012151.png" />
    </ItemGroup>

    <ItemGroup>
      <None Update="img\imgGive_money.jpg">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
      <None Update="img\imgTake_money.jpg">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
      <Resource Include="img\metal_gold.png">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </Resource>
      <Resource Include="img\metal_silver.png">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </Resource>
      <Resource Include="img\item_necklace.png">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </Resource>
      <Resource Include="img\item_tops.png">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </Resource>
      <Resource Include="img\item_chain.png">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </Resource>
      <Resource Include="img\item_ring.png">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </Resource>
      <Resource Include="img\item_other.png">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </Resource>
      <Resource Include="img\item_chori.png">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </Resource>
    </ItemGroup>

</Project>
